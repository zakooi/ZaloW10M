<Page
    x:Class="ZaloW10M.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0068FF" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="&#xE0C4;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" Click="Back_Click" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Messages -->
        <ListView Grid.Row="1" ItemsSource="{Binding Messages}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Border Background="{Binding IsOutgoing, Converter={StaticResource BoolToColorConverter}}" 
                                HorizontalAlignment="{Binding IsOutgoing, Converter={StaticResource BoolToAlignConverter}}" 
                                CornerRadius="12" Padding="12,8" MaxWidth="280">
                            <StackPanel>
                                <TextBlock Text="{Binding Content}" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="Gray" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Input Box -->
        <Grid Grid.Row="2" Background="#F7F7F7" Padding="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding InputMessage, Mode=TwoWay}" PlaceholderText="Nhập tin nhắn..." Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Gửi" Background="#0068FF" Foreground="White" Command="{Binding SendCommand}"/>
        </Grid>
    </Grid>
</Page>