<Page
    x:Class="ZaloW10M.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
            <TextBlock Text="Zalo cho Windows 10 Mobile" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#0068FF"/>
            
            <Border Width="220" Height="220" Background="#F0F0F0" CornerRadius="8" BorderBrush="#DDDDDD" BorderThickness="1">
                <Grid>
                    <Image Source="{Binding QrImage}" Stretch="Uniform" Margin="10"/>
                    <ProgressRing IsActive="{Binding IsLoading}" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="Gray" MaxWidth="260"/>

            <Button Content="Làm mới mã QR" HorizontalAlignment="Center" Click="RefreshQR_Click"/>
        </StackPanel>
    </Grid>
</Page>