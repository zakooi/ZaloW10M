<Page
    x:Class="ZaloW10M.Views.ChatListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0068FF" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <TextBlock Text="Zalo" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding StatusText}" Margin="12,4,0,0" FontSize="12" Foreground="#D0E2FF"/>
            </StackPanel>
        </Border>

        <!-- Conversation List -->
        <ListView Grid.Row="1" ItemsSource="{Binding Conversations}" ItemClick="Conversation_Click" IsItemClickEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#EEEEEE">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar placeholder -->
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#0068FF" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name[0]}" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="{Binding LastMessage}" Foreground="Gray" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>